{
  "name": "search-readonly-live",
  "role_name": "permission-compiler-search-readonly",
  "steps": [
    {
      "id": "search-logs",
      "method": "POST",
      "path": "/permission-demo-logs-*/_search",
      "body": {
        "size": 10,
        "query": {
          "match_all": {}
        }
      },
      "index_patterns": [
        "permission-demo-logs-*"
      ],
      "expect": "allow"
    },
    {
      "id": "read-index-settings",
      "method": "GET",
      "path": "/permission-demo-logs-*/_settings",
      "index_patterns": [
        "permission-demo-logs-*"
      ],
      "expect": "allow"
    },
    {
      "id": "must-not-delete-index",
      "method": "DELETE",
      "path": "/permission-demo-logs-2026.07.29",
      "index_patterns": [
        "permission-demo-logs-*"
      ],
      "expect": "deny"
    },
    {
      "id": "must-not-read-security-index",
      "method": "GET",
      "path": "/.opendistro_security/_search",
      "index_patterns": [
        ".opendistro_security"
      ],
      "expect": "deny"
    }
  ]
}
